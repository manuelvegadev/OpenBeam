<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>Open Beam</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>Open Beam needs camera access to capture and broadcast video over NDI.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Open Beam needs microphone access to capture and broadcast audio over NDI.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Open Beam uses the local network to broadcast NDI video to other devices and to synchronize the clipboard with paired devices.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_ndi._tcp</string>
		<string>_clipsync._tcp</string>
	</array>
	<key>NSHumanReadableCopyright</key>
	<string></string>
</dict>
</plist>
